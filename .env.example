NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. DB/Storage administration and application session RPCs.
SUPABASE_SECRET_KEY=
APP_URL=http://localhost:3000
# Google Auth Platform > Clients > Web application.
# Authorized redirect URI: <APP_URL>/auth/callback (not Supabase's callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 random bytes. Server only; signs short-lived OAuth transactions.
AUTH_SECRET=
# Private ES256 JWK imported into Supabase JWT Signing Keys, including its kid.
# This authorizes DB/Storage/Realtime only; Supabase Auth does not handle logins.
SUPABASE_SIGNING_JWK=
# Defaults to production when omitted. Restart the server after changing.
# development allows any verified Google account.
# All servers connected to this project must use the same APP_ENV.
APP_ENV=production

# Web Push: generate once with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A real contact mailto: address or HTTPS URL.
VAPID_SUBJECT=

# PostHog browser analytics configuration.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry: public DSN defaults to this application's Sentry project when omitted.
NEXT_PUBLIC_SENTRY_DSN=https://1aae069856a229384efd225b88df273a@o4512399029305344.ingest.us.sentry.io/4512399058272256
# Optional overrides; Vercel environment and commit SHA are used automatically.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_RELEASE=<commit-sha>
# Build-time secret for source-map uploads. Configure in Vercel, never commit.
SENTRY_AUTH_TOKEN=
