NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used for uploads and synchronizing the database access policy.
SUPABASE_SECRET_KEY=
APP_URL=http://localhost:3000
# Defaults to production when omitted. Restart the server after changing.
# development allows any verified Google account on the same Supabase project.
# All servers connected to this project must use the same APP_ENV.
APP_ENV=production
